<odoo>
    <record id="tax_report_line_stamp" model="account.report.line">
        <field name="name">Stamp duty on invoices</field>
        <field name="report_id" ref="l10n_tn.tax_report" />
        <field name="hierarchy_level">0</field>
        <field name="sequence">1010</field>
        <field name="code">l10n_tn_stamp_sale</field>
        <field name="expression_ids">
            <record id="tax_report_line_stamp_due" model="account.report.expression">
                <field name="label">vat_due</field>
                <field name="engine">tax_tags</field>
                <field name="formula">stamp_sale_due</field>
            </record>
        </field>
    </record>
</odoo>
