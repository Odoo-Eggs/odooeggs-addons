<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.l10n_tn_stamp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="rounding_method" position="after">
                <setting
                    id="l10n_tn_stamp_invoice_mention"
                    company_dependent="1"
                    invisible="country_code != 'TN'"
                    string="Stamp duty mention"
                    help="Print « Droit de timbre payé sur déclaration » on the invoices that carry the fiscal stamp (stamp duty code, art. 127). Not printed in usual Tunisian practice."
                >
                    <field name="l10n_tn_stamp_invoice_mention" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
